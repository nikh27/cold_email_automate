# ──────────────────────────────────────────────
#  Gmail Credentials
#  Go to myaccount.google.com > Security > App Passwords
#  Generate an App Password for "Mail" > "Windows Computer"
# ──────────────────────────────────────────────
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ──────────────────────────────────────────────
#  Sending Limits (30-day plan = 62/day)
# ──────────────────────────────────────────────
DAILY_LIMIT=62
MORNING_BATCH_SIZE=30
EVENING_BATCH_SIZE=32

# Delay between each email in seconds (random between MIN and MAX)
# 90s min = ~45 minutes for 30 emails. Safe, human-like.
MIN_DELAY=90
MAX_DELAY=240

# ──────────────────────────────────────────────
#  Security Key (used to protect /api/send-batch)
#  Set this to any random long string.
#  Add the SAME value to your Upstash QStash header.
# ──────────────────────────────────────────────
API_KEY=change-this-to-a-secret-key-123

# ──────────────────────────────────────────────
#  App secret (for Flask sessions)
# ──────────────────────────────────────────────
SECRET_KEY=flask-session-secret-soumya-2026

# ──────────────────────────────────────────────
#  File paths (don't change unless you rename files)
# ──────────────────────────────────────────────
CONTACTS_FILE=Company Wise HR Contacts - HR Contacts.xlsx
DB_FILE=email_tracker.db
RESUME_FILE=resume.pdf
